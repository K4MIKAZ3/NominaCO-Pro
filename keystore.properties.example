storeFile=release.keystore
storePassword=CAMBIAR_STORE_PASSWORD
keyAlias=nominacopro
keyPassword=CAMBIAR_KEY_PASSWORD

# CI: los valores reales viven en GitHub Secrets (RELEASE_*).
# Local: copia este archivo a keystore.properties y coloca release.keystore en la raíz.
# Si alguna vez usaste la contraseña por defecto del repo, rota el keystore y actualiza los secrets.
