# Supabase (mismas credenciales que la app Android)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Enlace directo de descarga APK (GitHub Releases por defecto)
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://github.com/K4MIKAZ3/NominaCO-Pro/releases/latest/download/Nominapp.apk

# Formulario de contacto (Resend → https://resend.com)
RESEND_API_KEY=re_...
# Remitente (dominio verificado en Resend)
RESEND_FROM_EMAIL=Nominapp <contacto@nominapp.xyz>
# Opcional: buzón interno donde recibes los mensajes del formulario
CONTACT_TO_EMAIL=tu-correo-interno@ejemplo.com

# Política de contraseña (Supabase Dashboard → Authentication → Providers → Email):
# Mínimo 6 caracteres; activa mayúscula, minúscula, número y carácter especial (debe coincidir con app y web).
#
# Configurar en Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://www.nominapp.xyz
# Redirect URLs (añade TODAS las variantes):
#   https://www.nominapp.xyz/**
#   https://www.nominapp.xyz/restablecer-contrasena
#   https://nominapp.xyz/**
#   https://nominapp.xyz/restablecer-contrasena
#
# Si falta www.nominapp.xyz en Redirect URLs, el enlace del correo cae en la home con error otp_expired.
#
# Google Search Console (opcional, para verificación de propiedad del sitio)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123...
