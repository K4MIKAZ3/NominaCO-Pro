# Supabase (mismas credenciales que la app Android)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Enlace directo de descarga APK (MediaFire u otro)
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://www.mediafire.com/file/TU_ENLACE/nominapp.apk/file

# Formulario de contacto (Resend → https://resend.com)
RESEND_API_KEY=re_...
# Remitente (dominio verificado en Resend)
RESEND_FROM_EMAIL=NominaApp <contacto@nominapp.xyz>
# Opcional: destino (por defecto site.contactEmail)
CONTACT_TO_EMAIL=mrlegnaoficial@gmail.com

# Configurar en Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://nominapp.xyz
# Redirect URLs:
#   https://nominapp.xyz/**
#   https://nominapp.xyz/login
#   https://nominapp.xyz/restablecer-contrasena
