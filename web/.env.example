# URL publica del sitio desplegado en Vercel
NEXT_PUBLIC_SITE_URL=https://vibe-coding-company.vercel.app

# Supabase (solo si mantienes rutas internas de cuenta)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Formulario de contacto (Resend → https://resend.com)
RESEND_API_KEY=re_...
# Remitente (dominio verificado en Resend)
RESEND_FROM_EMAIL=Vibe Coding Company <contacto@vibecoding.company>
# Opcional: buzón interno donde recibes los mensajes del formulario
CONTACT_TO_EMAIL=tu-correo-interno@ejemplo.com
# Correo publico mostrado en el sitio
NEXT_PUBLIC_CONTACT_EMAIL=contacto@vibecoding.company

# Política de contraseña (Supabase Dashboard → Authentication → Providers → Email):
# Mínimo 6 caracteres; activa mayúscula, minúscula, número y carácter especial (debe coincidir con app y web).
#
# Configurar en Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://vibe-coding-company.vercel.app
# Redirect URLs:
#   https://vibe-coding-company.vercel.app/**
#   https://vibe-coding-company.vercel.app/login
#   https://vibe-coding-company.vercel.app/restablecer-contrasena
#
# Google Search Console (opcional, para verificación de propiedad del sitio)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123...
